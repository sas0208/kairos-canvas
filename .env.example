# Demo mode is ON by default. Set to "false" to talk to a real backend.
VITE_DEMO=true

# Only used when VITE_DEMO=false.
# Absolute URL of the backend (requests to /api/... are rewritten to it; needs CORS)...
# VITE_API_BASE=http://localhost:8787
# ...or let the Vite dev server proxy /api to it (no CORS needed).
# VITE_API_PROXY=http://127.0.0.1:8787
